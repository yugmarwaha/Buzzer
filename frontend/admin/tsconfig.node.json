{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "composite": true,
    "rootDir": "..",
    "outDir": "./node_modules/.tmp/node-out"
  },
  "include": ["vite.config.ts", "tailwind.config.ts", "../tailwind.preset.ts"]
}
